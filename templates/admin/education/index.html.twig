{% extends 'base.html.twig' %}

{% block title %}Manage Education — {{ content.hero.name }}{% endblock %}
{% block meta_description %}Admin: manage education entries.{% endblock %}

{% block body %}
    <section class="admin">
        <h1>Education</h1>
        <p><a href="{{ path('admin_dashboard') }}">&larr; Admin home</a></p>

        <a class="button button--primary" href="{{ path('admin_education_new') }}">Add education entry</a>

        <div class="admin__list">
            {% for entry in entries %}
                <article class="admin__row">
                    <div>
                        <span class="experience__years">
                            {{ entry.startDate|date('M Y') }} &ndash; {{ entry.endDate ? entry.endDate|date('M Y') : 'Present' }}
                        </span>
                        <strong>{{ entry.qualification }}</strong> — {{ entry.university }}
                        <div>{{ entry.courses|length }} course{{ entry.courses|length == 1 ? '' : 's' }}</div>
                    </div>
                    <div class="admin__row-actions">
                        <a href="{{ path('admin_education_courses', {id: entry.id}) }}">Courses</a>
                        <a href="{{ path('admin_education_edit', {id: entry.id}) }}">Edit</a>
                        <form method="post" action="{{ path('admin_education_delete', {id: entry.id}) }}" onsubmit="return confirm('Delete this education entry and all its courses?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete-education-' ~ entry.id) }}">
                            <button type="submit" class="admin__delete-button">Delete</button>
                        </form>
                    </div>
                </article>
            {% else %}
                <p>No education entries yet.</p>
            {% endfor %}
        </div>
    </section>
{% endblock %}
