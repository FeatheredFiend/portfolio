{% extends 'base.html.twig' %}

{% block title %}Manage Employment — {{ content.hero.name }}{% endblock %}
{% block meta_description %}Admin: manage employment entries.{% endblock %}

{% block body %}
    <section class="admin">
        <h1>Employment</h1>
        <p><a href="{{ path('admin_dashboard') }}">&larr; Admin home</a></p>

        <a class="button button--primary" href="{{ path('admin_employment_new') }}">Add employment entry</a>

        <div class="admin__list">
            {% for entry in entries %}
                <article class="admin__row">
                    <div>
                        <span class="experience__years">
                            {{ entry.startDate|date('M Y') }} &ndash; {{ entry.endDate ? entry.endDate|date('M Y') : 'Present' }}
                        </span>
                        <strong>{{ entry.companyTitle }} at {{ entry.companyName }}</strong>
                    </div>
                    <div class="admin__row-actions">
                        <a href="{{ path('admin_employment_edit', {id: entry.id}) }}">Edit</a>
                        <form method="post" action="{{ path('admin_employment_delete', {id: entry.id}) }}" onsubmit="return confirm('Delete this employment entry?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete-employment-' ~ entry.id) }}">
                            <button type="submit" class="admin__delete-button">Delete</button>
                        </form>
                    </div>
                </article>
            {% else %}
                <p>No employment entries yet.</p>
            {% endfor %}
        </div>
    </section>
{% endblock %}
